      "glsl1": {
        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nattribute vec3 a_position;\nattribute vec2 a_uv0;\nattribute vec4 a_color;\nvarying vec2 v_uv0;\nvarying vec4 v_color;\nvoid main () {\n  vec4 pos = vec4(a_position, 1);\n  #if CC_USE_MODEL\n    pos = cc_matViewProj * cc_matWorld * pos;\n  #else\n    pos = cc_matViewProj * pos;\n  #endif\n  v_uv0 = a_uv0;\n  v_color = a_color;\n  gl_Position = pos;\n}",
        "frag": "\n#if CC_SUPPORT_standard_derivatives\n  #extension GL_OES_standard_derivatives : enable\n#endif\nprecision highp float;\nvarying vec2 v_uv0;\nvarying vec4 v_color;\nuniform sampler2D texture;\nuniform vec2 shapeParams;\nuniform vec2 textureTexel;\nvec4 sampleTexture(vec2 uv) {\n  #if SUPERSAMPLE_TEXTURE && CC_SUPPORT_standard_derivatives\n    vec2 offset = max(fwidth(uv) * 0.35, textureTexel * 0.3);\n    vec4 color =\n        texture2D(texture, uv + vec2(-offset.x, -offset.y)) +\n        texture2D(texture, uv + vec2( offset.x, -offset.y)) +\n        texture2D(texture, uv + vec2(-offset.x,  offset.y)) +\n        texture2D(texture, uv + vec2( offset.x,  offset.y));\n    return color * 0.25;\n  #else\n    return texture2D(texture, uv);\n  #endif\n}\nfloat roundedRectDistance(vec2 uv) {\n  float aspect = shapeParams.x;\n  float cornerRadius = shapeParams.y;\n  vec2 halfSize = vec2(aspect * 0.5, 0.5);\n  vec2 p = vec2((uv.x - 0.5) * aspect, uv.y - 0.5);\n  vec2 q = abs(p) - (halfSize - vec2(cornerRadius));\n  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - cornerRadius;\n}\nfloat roundedRectAlpha(vec2 uv) {\n  float distanceToEdge = roundedRectDistance(uv);\n  #if CC_SUPPORT_standard_derivatives\n    float edgeSoftness = max(fwidth(distanceToEdge) * 1.5, 0.00075);\n  #else\n    float edgeSoftness = 0.008;\n  #endif\n  return 1.0 - smoothstep(-edgeSoftness, edgeSoftness, distanceToEdge);\n}\nfloat circleAlpha(vec2 uv) {\n  float radius = length(uv - vec2(0.5));\n  #if CC_SUPPORT_standard_derivatives\n    float edgeSoftness = max(fwidth(radius) * 1.5, 0.00075);\n  #else\n    float edgeSoftness = 0.008;\n  #endif\n  return 1.0 - smoothstep(0.5 - edgeSoftness, 0.5 + edgeSoftness, radius);\n}\nvoid main () {\n  #if SOLID_CIRCLE\n    vec4 color = v_color;\n    color.a *= circleAlpha(v_uv0);\n  #else\n    vec4 textureColor = sampleTexture(v_uv0);\n    #if ROUNDED_RECT && SAFE_EDGE_COLOR\n      vec2 safeUv = mix(vec2(0.5), v_uv0, 0.9);\n      vec3 safeRgb = sampleTexture(safeUv).rgb;\n      float safeColorMix = smoothstep(-0.06, -0.005, roundedRectDistance(v_uv0));\n      textureColor.rgb = mix(textureColor.rgb, safeRgb, safeColorMix);\n    #endif\n    #if CC_USE_ALPHA_ATLAS_texture\n      textureColor.a *= texture2D(texture, v_uv0 + vec2(0, 0.5)).r;\n    #endif\n    #if INPUT_IS_GAMMA\n      textureColor.rgb *= textureColor.rgb;\n    #endif\n    vec4 color = textureColor * v_color;\n    #if ROUNDED_RECT\n      float shapeAlpha = roundedRectAlpha(v_uv0);\n      #if REPLACE_TEXTURE_ALPHA\n        color.a = v_color.a * shapeAlpha;\n      #else\n        color.a *= shapeAlpha;\n      #endif\n    #endif\n  #endif\n  gl_FragColor = color;\n}"
      },
      "glsl3": {
        "vert": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nuniform CCLocal {\n  mat4 cc_matWorld;\n  mat4 cc_matWorldIT;\n};\nin vec3 a_position;\nin vec2 a_uv0;\nin vec4 a_color;\nout vec2 v_uv0;\nout vec4 v_color;\nvoid main () {\n  vec4 pos = vec4(a_position, 1);\n  #if CC_USE_MODEL\n    pos = cc_matViewProj * cc_matWorld * pos;\n  #else\n    pos = cc_matViewProj * pos;\n  #endif\n  v_uv0 = a_uv0;\n  v_color = a_color;\n  gl_Position = pos;\n}",
        "frag": "\n#if CC_SUPPORT_standard_derivatives\n  #extension GL_OES_standard_derivatives : enable\n#endif\nprecision highp float;\nin vec2 v_uv0;\nin vec4 v_color;\nuniform sampler2D texture;\nuniform Properties {\n  vec2 shapeParams;\n  vec2 textureTexel;\n};\nvec4 sampleTexture(vec2 uv) {\n  #if SUPERSAMPLE_TEXTURE && CC_SUPPORT_standard_derivatives\n    vec2 offset = max(fwidth(uv) * 0.35, textureTexel * 0.3);\n    vec4 color =\n        texture(texture, uv + vec2(-offset.x, -offset.y)) +\n        texture(texture, uv + vec2( offset.x, -offset.y)) +\n        texture(texture, uv + vec2(-offset.x,  offset.y)) +\n        texture(texture, uv + vec2( offset.x,  offset.y));\n    return color * 0.25;\n  #else\n    return texture(texture, uv);\n  #endif\n}\nfloat roundedRectDistance(vec2 uv) {\n  float aspect = shapeParams.x;\n  float cornerRadius = shapeParams.y;\n  vec2 halfSize = vec2(aspect * 0.5, 0.5);\n  vec2 p = vec2((uv.x - 0.5) * aspect, uv.y - 0.5);\n  vec2 q = abs(p) - (halfSize - vec2(cornerRadius));\n  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - cornerRadius;\n}\nfloat roundedRectAlpha(vec2 uv) {\n  float distanceToEdge = roundedRectDistance(uv);\n  #if CC_SUPPORT_standard_derivatives\n    float edgeSoftness = max(fwidth(distanceToEdge) * 1.5, 0.00075);\n  #else\n    float edgeSoftness = 0.008;\n  #endif\n  return 1.0 - smoothstep(-edgeSoftness, edgeSoftness, distanceToEdge);\n}\nfloat circleAlpha(vec2 uv) {\n  float radius = length(uv - vec2(0.5));\n  #if CC_SUPPORT_standard_derivatives\n    float edgeSoftness = max(fwidth(radius) * 1.5, 0.00075);\n  #else\n    float edgeSoftness = 0.008;\n  #endif\n  return 1.0 - smoothstep(0.5 - edgeSoftness, 0.5 + edgeSoftness, radius);\n}\nvoid main () {\n  #if SOLID_CIRCLE\n    vec4 color = v_color;\n    color.a *= circleAlpha(v_uv0);\n  #else\n    vec4 textureColor = sampleTexture(v_uv0);\n    #if ROUNDED_RECT && SAFE_EDGE_COLOR\n      vec2 safeUv = mix(vec2(0.5), v_uv0, 0.9);\n      vec3 safeRgb = sampleTexture(safeUv).rgb;\n      float safeColorMix = smoothstep(-0.06, -0.005, roundedRectDistance(v_uv0));\n      textureColor.rgb = mix(textureColor.rgb, safeRgb, safeColorMix);\n    #endif\n    #if CC_USE_ALPHA_ATLAS_texture\n      textureColor.a *= texture(texture, v_uv0 + vec2(0, 0.5)).r;\n    #endif\n    #if INPUT_IS_GAMMA\n      textureColor.rgb *= textureColor.rgb;\n    #endif\n    vec4 color = textureColor * v_color;\n    #if ROUNDED_RECT\n      float shapeAlpha = roundedRectAlpha(v_uv0);\n      #if REPLACE_TEXTURE_ALPHA\n        color.a = v_color.a * shapeAlpha;\n      #else\n        color.a *= shapeAlpha;\n      #endif\n    #endif\n  #endif\n  gl_FragColor = color;\n}"
