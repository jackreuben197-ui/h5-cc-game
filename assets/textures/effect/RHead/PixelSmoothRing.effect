CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        texture: { value: white }
}%


CCProgram vs %{
  precision highp float;

  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec2 a_uv0;
  in vec4 a_color;

  out vec2 v_uv0;
  out vec4 v_color;

  void main () {
    vec4 pos = vec4(a_position, 1);

    #if CC_USE_MODEL
      pos = cc_matViewProj * cc_matWorld * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    v_uv0 = a_uv0;
    v_color = a_color;
    gl_Position = pos;
  }
}%


CCProgram fs %{
  #if CC_SUPPORT_standard_derivatives
    #extension GL_OES_standard_derivatives : enable
  #endif

  precision highp float;

  in vec2 v_uv0;
  in vec4 v_color;

  uniform sampler2D texture;

  void main () {
    float radius = length(v_uv0 - vec2(0.5));

    #if CC_SUPPORT_standard_derivatives
      float edgeSoftness = max(fwidth(radius) * 1.5, 0.00075);
    #else
      float edgeSoftness = 0.008;
    #endif

    float innerAlpha = smoothstep(0.437, 0.437 + edgeSoftness, radius);
    float outerAlpha = 1.0 - smoothstep(0.5 - edgeSoftness, 0.5, radius);

    vec4 color = v_color;
    #if BORDER_STYLE
      color *= vec4(0.866, 0.862, 0.863, 0.35);
    #endif

    color.a *= innerAlpha * outerAlpha;
    gl_FragColor = color;
  }
}%
