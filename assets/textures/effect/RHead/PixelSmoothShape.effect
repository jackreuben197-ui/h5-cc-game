CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        texture: { value: white }
        shapeParams: { value: [1, 0.1] }
}%


CCProgram vs %{
  precision highp float;

  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec2 a_uv0;
  in vec4 a_color;

  out vec2 v_uv0;
  out vec4 v_color;

  void main () {
    vec4 pos = vec4(a_position, 1);

    #if CC_USE_MODEL
      pos = cc_matViewProj * cc_matWorld * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    v_uv0 = a_uv0;
    v_color = a_color;
    gl_Position = pos;
  }
}%


CCProgram fs %{
  #if CC_SUPPORT_standard_derivatives
    #extension GL_OES_standard_derivatives : enable
  #endif

  precision highp float;

  in vec2 v_uv0;
  in vec4 v_color;

  uniform sampler2D texture;
  uniform Properties {
    // x: width / height, y: corner radius measured against height.
    vec2 shapeParams;
  };

  vec4 sampleTexture(vec2 uv) {
    #if SUPERSAMPLE_TEXTURE && CC_SUPPORT_standard_derivatives
      vec2 offset = fwidth(uv) * 0.35;
      vec4 color =
          texture(texture, uv + vec2(-offset.x, -offset.y)) +
          texture(texture, uv + vec2( offset.x, -offset.y)) +
          texture(texture, uv + vec2(-offset.x,  offset.y)) +
          texture(texture, uv + vec2( offset.x,  offset.y));
      return color * 0.25;
    #else
      return texture(texture, uv);
    #endif
  }

  float roundedRectAlpha(vec2 uv) {
    float aspect = shapeParams.x;
    float cornerRadius = shapeParams.y;
    vec2 halfSize = vec2(aspect * 0.5, 0.5);
    vec2 p = vec2((uv.x - 0.5) * aspect, uv.y - 0.5);
    vec2 q = abs(p) - (halfSize - vec2(cornerRadius));
    float distanceToEdge = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - cornerRadius;

    #if CC_SUPPORT_standard_derivatives
      float edgeSoftness = max(fwidth(distanceToEdge) * 1.5, 0.00075);
    #else
      float edgeSoftness = 0.008;
    #endif

    return 1.0 - smoothstep(-edgeSoftness, edgeSoftness, distanceToEdge);
  }

  float circleAlpha(vec2 uv) {
    float radius = length(uv - vec2(0.5));

    #if CC_SUPPORT_standard_derivatives
      float edgeSoftness = max(fwidth(radius) * 1.5, 0.00075);
    #else
      float edgeSoftness = 0.008;
    #endif

    return 1.0 - smoothstep(0.5 - edgeSoftness, 0.5 + edgeSoftness, radius);
  }

  void main () {
    #if SOLID_CIRCLE
      vec4 color = v_color;
      color.a *= circleAlpha(v_uv0);
    #else
      vec4 textureColor = sampleTexture(v_uv0);

      #if CC_USE_ALPHA_ATLAS_texture
        textureColor.a *= texture(texture, v_uv0 + vec2(0, 0.5)).r;
      #endif

      #if INPUT_IS_GAMMA
        textureColor.rgb *= textureColor.rgb;
      #endif

      vec4 color = textureColor * v_color;

      #if ROUNDED_RECT
        float shapeAlpha = roundedRectAlpha(v_uv0);
        #if REPLACE_TEXTURE_ALPHA
          color.a = v_color.a * shapeAlpha;
        #else
          color.a *= shapeAlpha;
        #endif
        color.rgb *= shapeAlpha;
      #endif
    #endif

    gl_FragColor = color;
  }
}%
